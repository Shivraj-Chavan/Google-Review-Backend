# --------------------------------------------------
# Server
# --------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# --------------------------------------------------
# MySQL
# --------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=review_booster

# --------------------------------------------------
# JWT
# --------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --------------------------------------------------
# Google OAuth (Google Identity Services)
# Create credentials at https://console.cloud.google.com/apis/credentials
# --------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --------------------------------------------------
# Admin (used only the very first time to log in before you change it)
# --------------------------------------------------
ADMIN_SEED_EMAIL=admin@reviewbooster.app
ADMIN_SEED_PASSWORD=Admin@123

# --------------------------------------------------
# AI Review Generation
# Optional: if ANTHROPIC_API_KEY is set, real AI generation (Claude) is used.
# If left blank, a deterministic template-based generator is used instead,
# so the product works fully out of the box with no external AI dependency.
# --------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --------------------------------------------------
# Uploads
# --------------------------------------------------
MAX_LOGO_SIZE_MB=2
MAX_GALLERY_IMAGE_SIZE_MB=5
MAX_GALLERY_IMAGES=10

# --------------------------------------------------
# Rate limiting
# --------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
